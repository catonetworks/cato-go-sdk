  muted: Boolean!
  os: String
  predictedThreatType: String
  predictedVerdict: StoryVerdictEnum
  producer: StoryProducerEnum! @deprecated(reason: "use 'producerType' instead")
  producerName: String!
  producerType: StoryProducerEnum!
  queryName: String
  research: Boolean
  rules: [String!]
  similarStoriesData: [SimilarStoryData!]!
  site: SiteRef
