  frequency: PolicyRuleTrackingFrequencyEnum! = HOURLY
  mailingList: [SubscriptionMailingListRefInput!]! = []
  subscriptionGroup: [SubscriptionGroupRefInput!]! = []
  webhook: [SubscriptionWebhookRefInput!]! = []
}

