  internetOnly: Boolean
  localIp: IPAddress
  mdnsReflector: Boolean
  name: String!
  rangeType: SubnetType!
  subnet: IPSubnet!
  translatedSubnet: IPSubnet
  vlan: Int
}

""" Input for creating a partner account access request. """
