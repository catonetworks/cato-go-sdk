  lastmileLatency
  """ multiple last mile destinations measured packet loss """
  lastmilePacketLoss
  """ missing data """
  missingData
  """ some packets were queued """
  overlowed
  """ packet loss connectivity issue """
  packetLoss
  """ interface in standby mode """
  passiveLink
