  flowStartTime: DateTime! @deprecated(reason: "use 'firstSignal' instead")
  id: ID!
  indication: String!
  ioa: String! @deprecated(reason: "'ioa' is deprecated, use 'indication' instead")
  lastSignal: DateTime!
  muted: Boolean!
