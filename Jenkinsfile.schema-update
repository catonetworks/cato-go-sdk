import groovy.json.JsonOutput

// Scheduled SDK schema refresh job.
//
// Required Jenkins credentials:
//   automation-github-user       -> GitHub checkout credentials
//   cato-schema-update-gh-token  -> GitHub token with least-privilege access to
//                                   push branches and create pull requests in
//                                   catonetworks/cato-go-sdk
//   cato-acc-slack-token         -> Jenkins Bot token to send PR updates

pipeline {
    agent {
        docker {
            image 'golang:1.26'
            args  '-e GOCACHE=/tmp/go-cache -e GOPATH=/tmp/gopath'
        }
    }

    triggers {
        cron('H H * * 1')
    }

    parameters {
        string(
            name: 'BASE_BRANCH',
            defaultValue: 'main',
            description: 'Branch to update from and target for the generated pull request.'
        )
        string(
            name: 'SCHEMA_CURL_URL',
            defaultValue: 'https://system.cc.catonetworks.com/api/schema?with_undocumented=true',
            description: 'Schema endpoint. Scheduled runs should use the default Cato endpoint.'
        )
        string(
            name: 'SLACK_CHANNEL',
            defaultValue: '#eng-proj-terraform-tests',
            description: 'Slack channel for schema update failure notifications.'
        )
        string(
            name: 'PR_SLACK_CHANNEL',
            defaultValue: '#terraform-prs',
            description: 'Slack channel for schema update pull request notifications.'
        )
        booleanParam(
            name: 'ALLOW_CUSTOM_SCHEMA_URL',
            defaultValue: false,
            description: 'Allow a trusted manual run to fetch from a non-default HTTPS schema URL.'
        )
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 2, unit: 'HOURS')
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                git(
                    credentialsId: 'automation-github-user',
                    url: 'https://github.com/catonetworks/cato-go-sdk.git',
                    branch: params.BASE_BRANCH
                )
            }
        }

        stage('Refresh schema') {
            steps {
                withEnv([
                    "SCHEMA_CURL_URL=${params.SCHEMA_CURL_URL}",
                    "ALLOW_CUSTOM_SCHEMA_URL=${params.ALLOW_CUSTOM_SCHEMA_URL}",
                    'SCHEMA_PATCH_MANUAL_WORK_FILE=schema-patch-manual-work-needed.txt'
                ]) {
                    sh 'bash scripts/schema_update_ci.sh'
                }
            }
        }

        stage('Prepare branch') {
            steps {
                script {
                    env.CHANGES_DETECTED = sh(
                        script: 'if [ -n "$(git status --porcelain)" ]; then echo true; else echo false; fi',
                        returnStdout: true
                    ).trim()

                    if (env.CHANGES_DETECTED != 'true') {
                        currentBuild.description = 'No schema changes'
                        echo 'No schema changes detected; skipping branch and PR creation.'
                        return
                    }

                    def stamp = sh(script: 'date -u +%Y%m%d-%H%M%S', returnStdout: true).trim()
                    env.SCHEMA_UPDATE_BRANCH = "automation/schema-update-${stamp}"
                    sh '''
                        git checkout -B "$SCHEMA_UPDATE_BRANCH"
                        git add -A -- \
                          cato_api.graphqls \
                          client.go \
                          models/models.go \
                          schema-patches \
                          scalars \
                          sources \
                          .gqlgenc.yml \
                          go.mod \
                          go.sum

                        git -c user.name='cato-sdk-automation' \
                            -c user.email='cato-sdk-automation@users.noreply.github.com' \
                            commit -m 'Update generated SDK schema' \
                                   -m 'Refresh the Cato GraphQL schema from upstream, apply schema patches, regenerate the SDK, and verify the build.'
                    '''
                    currentBuild.description = "Prepared ${env.SCHEMA_UPDATE_BRANCH}"
                }
            }
        }

        stage('Push branch') {
            when {
                expression { env.CHANGES_DETECTED == 'true' }
            }
            steps {
                withCredentials([string(credentialsId: 'cato-schema-update-gh-token', variable: 'GH_TOKEN')]) {
                    sh '''
                        askpass="$(mktemp)"
                        trap 'rm -f "$askpass"' EXIT
                        cat > "$askpass" <<'EOF'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' 'x-access-token' ;;
  *Password*) printf '%s\n' "$GH_TOKEN" ;;
  *) printf '\n' ;;
esac
EOF
                        chmod 700 "$askpass"

                        GIT_ASKPASS="$askpass" \
                        GIT_TERMINAL_PROMPT=0 \
                        git push https://github.com/catonetworks/cato-go-sdk.git "HEAD:${SCHEMA_UPDATE_BRANCH}"
                    '''
                }
            }
        }

        stage('Create pull request') {
            when {
                expression { env.CHANGES_DETECTED == 'true' }
            }
            steps {
                script {
                    def prTitle = 'Update generated SDK schema'
                    def prBody = '''## Summary
- Refreshes cato_api.graphqls from the upstream Cato schema endpoint.
- Applies and validates schema patches, deleting patch files that upstream now includes.
- Regenerates the Go SDK client/models and verifies `go build ./...`.

## Test plan
- `bash scripts/schema_update_ci.sh`
'''
                    writeFile(
                        file: 'pr_payload.json',
                        text: JsonOutput.toJson([
                            title: prTitle,
                            head: env.SCHEMA_UPDATE_BRANCH,
                            base: params.BASE_BRANCH,
                            body: prBody,
                            maintainer_can_modify: true
                        ])
                    )
                }

                withCredentials([string(credentialsId: 'cato-schema-update-gh-token', variable: 'GH_TOKEN')]) {
                    sh '''
                        curl_config="$(mktemp)"
                        trap 'rm -f "$curl_config"' EXIT
                        cat > "$curl_config" <<EOF
header = "Authorization: Bearer ${GH_TOKEN}"
header = "Accept: application/vnd.github+json"
header = "X-GitHub-Api-Version: 2022-11-28"
EOF

                        set +x
                        http_code="$(curl -sS -w '%{http_code}' -o pr_response.json \
                          -X POST \
                          --config "$curl_config" \
                          --data @pr_payload.json \
                          https://api.github.com/repos/catonetworks/cato-go-sdk/pulls)"
                        set -x

                        echo "GitHub pull request API response: HTTP ${http_code}"
                        cat pr_response.json

                        if [ "${http_code}" != "201" ]; then
                            exit 1
                        fi
                    '''
                }

                script {
                    def response = readJSON(file: 'pr_response.json', returnPojo: true)
                    env.SCHEMA_UPDATE_PR_URL = response.html_url as String\
                    if (!env.SCHEMA_UPDATE_PR_URL) {
                        error('GitHub pull request response did not include html_url.')
                    }

                    def schemaUpdateDate = sh(script: 'date -u +%F', returnStdout: true).trim()
                    slackSend(
                        channel: 'C0AUBS790S0',
                        botUser: true,
                        tokenCredentialId: 'cato-acc-slack-token',
                        message: "SDK Schema Update ${schemaUpdateDate} <${env.SCHEMA_UPDATE_PR_URL}>"
                    )
                }
            }
        }
    }

    post {
        failure {
            script {
                try {
                    if (fileExists('schema-patch-manual-work-needed.txt')) {
                        def manualWorkMessage = readFile('schema-patch-manual-work-needed.txt').trim()
                        slackSend(
                            channel: params.SLACK_CHANNEL,
                            color: 'warning',
                            message: "SDK schema update needs manual patch work | <${env.BUILD_URL}|Build #${env.BUILD_NUMBER}>\n```${manualWorkMessage}```"
                        )
                        archiveArtifacts(
                            artifacts: 'schema-patch-manual-work-needed.txt',
                            allowEmptyArchive: true
                        )
                    }
                } catch (ignore) {
                    echo 'Skipping schema patch failure notification because no workspace is available.'
                }
            }
        }
        cleanup {
            script {
                try { cleanWs() } catch (ignore) {}
            }
        }
    }
}
