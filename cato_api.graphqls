enum SandboxStatus {
  """ Report has expired """
  EXPIRED
  """ Analysis has failed """
  FAILED
  """ File is being analyzed """
  IN_PROGRESS
  """ File is pending analysis """
  PENDING
  """ File is queued for retry after throttling """
  QUEUED
  """ Analysis is complete - report is ready """
  READY
}

